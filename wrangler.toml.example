name = "product-catalog"
main = "worker/index.js"
compatibility_date = "2026-11-20"

[assets]
directory = "./site_dist"
binding = "ASSETS"
not_found_handling = "404-page"

[[d1_databases]]
binding = "DB"
database_name = "product-catalog"
database_id = "請在 Cloudflare 建立 D1 後填入實際 ID"
migrations_dir = "migrations"

# Free trial: images are stored in D1; no R2 subscription required.

# Cloudflare Secrets（不要寫入此檔）：
# ADMIN_USERNAME
# ADMIN_PASSWORD_HASH
# SESSION_SECRET
